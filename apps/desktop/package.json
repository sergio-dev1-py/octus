{
  "name": "@octus/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Octus desktop shell (Electron + SolidJS)",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "electron ./out/main/index.js --octus-smoke"
  },
  "dependencies": {
    "@octus/core": "workspace:*",
    "@octus/shared": "workspace:*",
    "dompurify": "3.4.17",
    "marked": "18.1.2",
    "solid-js": "1.9.18"
  },
  "devDependencies": {
    "electron": "45.2.0",
    "electron-vite": "6.0.0",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15"
  }
}
